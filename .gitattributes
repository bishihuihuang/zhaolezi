# 统一换行符，消除每次 git 操作的 LF/CRLF warning
* text=auto

# 文本文件统一用 LF（跨平台一致）
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp3 binary
*.ico binary
*.woff binary
*.woff2 binary
